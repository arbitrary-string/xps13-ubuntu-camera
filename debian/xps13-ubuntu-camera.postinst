#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
set -e
RELAY_CONF=/etc/v4l2-relayd.d/xps13-webcam.conf

write_relay_conf() {
	if ! id=$(xps13-camera-setup --camera-id 2>/dev/null); then
		echo "xps13-ubuntu-camera: RGB sensor not found; the Virtual Camera was not configured." >&2
		return 0
	fi
	# One backslash in the ACPI ID must become eight in this file: systemd's EnvironmentFile
	# parsing, the unit's  sh -c "..."  and GStreamer's parser each halve them.
	esc=$(printf '%s' "$id" | sed 's/\\/&&&&&&&&/g')
	mkdir -p /etc/v4l2-relayd.d
	cat > "$RELAY_CONF" <<CONF
# Generated by xps13-ubuntu-camera (re-generated on every package configure; do not edit).
# Relays the RGB webcam ($id) via libcamera into the v4l2loopback "Virtual Camera".
# Pipelines are caps-free on purpose: the relay forces FORMAT/WIDTH/HEIGHT/FRAMERATE itself.
# No videorate: it works from timestamps, and libcamerasrc timestamps drift away from the
# relay's clock, so videorate dropped most frames after a few minutes (or at once on IPU6).
VIDEOSRC="libcamerasrc camera-name=${esc} ! videoconvert ! videoscale"
SPLASHSRC="videotestsrc pattern=black num-buffers=4"
FORMAT=YUY2
WIDTH=1280
HEIGHT=720
FRAMERATE=30/1
CARD_LABEL="Virtual Camera"
CONF
	systemctl --system daemon-reload || true
	if lsmod | grep -q '^v4l2loopback '; then
		deb-systemd-invoke restart v4l2-relayd@xps13-webcam.service || true
	fi
}

#DEBHELPER#

if [ "$1" = configure ]; then
	xps13-camera-setup --configure || true
	write_relay_conf
	# Rebuild the initramfs so the camera drivers are kept out of it (see 90-xps13-camera.conf).
	if command -v update-initramfs >/dev/null 2>&1; then
		update-initramfs -u -k all || true
	fi
	if [ -e /etc/dracut.conf.d/90-camera-not-in-initramfs.conf ]; then
		echo "xps13-ubuntu-camera: note: /etc/dracut.conf.d/90-camera-not-in-initramfs.conf (manual install) is now redundant and can be removed."
	fi
	# Rules that set device.disabled can stall WirePlumber 0.5.17 (cameras AND audio vanish).
	for f in /home/*/.config/wireplumber/wireplumber.conf.d/*.conf /etc/wireplumber/wireplumber.conf.d/*.conf; do
		[ -f "$f" ] || continue
		if grep -v '^[[:space:]]*#' "$f" | grep -q 'device\.disabled'; then
			echo "xps13-ubuntu-camera: WARNING: $f uses device.disabled, which can stop WirePlumber from creating cameras and sound devices. Remove it or change it to node.disabled (see /usr/share/doc/xps13-ubuntu-camera/troubleshooting.md.gz)." >&2
		fi
	done
fi
exit 0
