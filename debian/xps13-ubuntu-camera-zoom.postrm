#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
set -e
RELAYD=/usr/bin/v4l2-relayd
case "$1" in
	remove|abort-install|disappear)
		rm -f /etc/v4l2-relayd.d/xps13-webcam.conf
		dpkg-divert --package xps13-ubuntu-camera-zoom --remove --rename --divert "$RELAYD.distrib" "$RELAYD"
		systemctl --system daemon-reload 2>/dev/null || true
		;;
esac
#DEBHELPER#
exit 0
